+	CFNumberRef limit = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt64Type, &bytesPerSec);
+	CFNumberRef duration = CFNumberCreate(kCFAllocatorDefault, kCFNumberDoubleType, &windowSec);
+	if (limit && duration)
+	{
+		const void *values[] = { limit, duration };
