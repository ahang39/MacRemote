+static void videotoolbox_encoder_set_data_rate_limits(H264_CONTEXT_VT_ENCODER *enc, UINT32 bitRate)
+{
+	/* Pair AverageBitRate with a 1-second DataRateLimits cap (~1.2x avg) so
+	 * scene cuts and full-screen scrolling do not spike past tight links. */
+	const int64_t bytesPerSec = MAX((int64_t)(((uint64_t)bitRate * 6u) / 40u), 16384);
