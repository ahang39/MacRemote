+/* Encode the already-prepared still YUV picture again as a normal P picture
+ * to sharpen residual quantization artifacts after motion stops. */
+INT32 avc420_repeat(H264_CONTEXT* h264, UINT32 width, UINT32 height, BYTE** ppDstData,
+                    UINT32* pDstSize, RDPGFX_H264_METABLOCK* meta)
+{
+	if (!h264 || !h264->Compressor || !h264->firstLumaFrameDone || !h264->subsystem ||
+	    !h264->subsystem->Compress || !ppDstData || !pDstSize || !meta || width == 0 ||
+	    height == 0 || width > UINT16_MAX || height > UINT16_MAX)
+		return -1;
+
+	const BYTE* frame[3];
+	for (size_t n = 0; n < 3; n++)
+		frame[n] = h264->encodingBuffer ? h264->pOldYUVData[n] : h264->pYUVData[n];
+
+	/* allocate_h264_metablock transfers ownership of this rectangle. */
+	RECTANGLE_16* full = malloc(sizeof(*full));
+	if (!full)
+		return -1;
+	*full = (RECTANGLE_16){ 0, 0, (UINT16)width, (UINT16)height };
+	if (!allocate_h264_metablock(h264->QP, full, meta, 1))
+	{
+		free_h264_metablock(meta);
+		return -1;
+	}
+
+	const INT32 result =
+	    h264->subsystem->Compress(h264, frame, h264->iStride, ppDstData, pDstSize);
+	if (result < 0 || *pDstSize == 0)
+	{
+		free_h264_metablock(meta);
+		return -1;
+	}
+	return 1;
+}
