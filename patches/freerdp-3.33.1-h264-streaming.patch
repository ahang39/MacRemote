@@ -0,0 +1,17 @@
+#ifndef SHADOW_STARTUP_PACING_H
+#define SHADOW_STARTUP_PACING_H
+#include <stdint.h>
+/* The first decoder acknowledgement marks the end of conservative startup.
+ * 0 retains FreeRDP's unlimited/no-ACK flow control configuration. */
+static inline uint32_t shadow_startup_ack_budget(uint32_t configured, int acked)
+{
+    return acked || configured <= 2 ? configured : 2;
+}
+/* Preserve the normal settled-decoder drain cadence; startup gets at most
+ * one synthetic H.264 picture per pacing pass. */
+static inline uint32_t shadow_startup_ack_drain_batch(uint32_t remaining, int acked)
+{
+    const uint32_t cap = acked ? 5 : 1;
+    return remaining < cap ? remaining : cap;
+}
+#endif
