@@ -0,0 +1,198 @@
+/* Pure-C stream pacing, FPS gating and frame-ACK RTT helpers for FreeRDP Shadow.
+ * Kept header-only so native unit tests exercise the exact production logic. */
+#ifndef SHADOW_STREAM_CONTROL_H
+#define SHADOW_STREAM_CONTROL_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct
+{
+	uint32_t bitrate;          /* H.264 target average bitrate (bps) */
+	uint32_t maxFps;           /* Max video FPS (60 High, 15 Low) */
+	uint32_t maxInFlight;      /* Max unacknowledged RDPGFX frames */
+	uint32_t pacerBytesPerSec; /* 0 = disabled; >0 = sustained video cap (B/s) */
+	uint32_t pacerBurstBytes;  /* Token bucket burst capacity (bytes) */
+	uint32_t refineDelayMs;    /* Delay before idle still-text refinement frame */
+	uint32_t refineFrames;     /* Idle refinement frames (default 1) */
+} ShadowStreamProfile;
+
+typedef struct
+{
+	const char* codec;
+	uint32_t colorDepth;
+	uint32_t videoBytesPerSec;
+	uint32_t videoFps;
+	uint32_t refineFrames;
+	uint32_t ackRttP50Ms;
+	uint32_t ackRttP95Ms;
+	int hasAckRtt;
+	uint32_t inFlightMax;
+} ShadowStreamStats;
+
+typedef struct
+{
+	int64_t tokens;
+	uint64_t lastTickMs;
+	uint32_t rateBytesPerSec;
+	uint32_t burstBytes;
+	int initialized;
+} ShadowStreamPacer;
+
+static inline void shadow_pacer_configure(ShadowStreamPacer* pacer, uint32_t rateBytesPerSec,
+                                          uint32_t burstBytes, uint64_t nowMs)
+{
+	if (!pacer)
+		return;
+	if (rateBytesPerSec == 0)
+	{
+		pacer->rateBytesPerSec = 0;
+		pacer->burstBytes = 0;
+		pacer->tokens = 0;
+		pacer->lastTickMs = nowMs;
+		pacer->initialized = 0;
+		return;
+	}
+	if (burstBytes == 0)
+		burstBytes = rateBytesPerSec / 2u;
+	if (!pacer->initialized || pacer->rateBytesPerSec != rateBytesPerSec ||
+	    pacer->burstBytes != burstBytes)
+	{
+		pacer->rateBytesPerSec = rateBytesPerSec;
+		pacer->burstBytes = burstBytes;
+		pacer->tokens = (int64_t)burstBytes;
+		pacer->lastTickMs = nowMs;
+		pacer->initialized = 1;
+	}
+}
+
+static inline void shadow_pacer_refill(ShadowStreamPacer* pacer, uint64_t nowMs)
+{
+	if (!pacer || !pacer->initialized || pacer->rateBytesPerSec == 0)
+		return;
+	if (nowMs <= pacer->lastTickMs)
+		return;
+	uint64_t elapsed = nowMs - pacer->lastTickMs;
+	if (elapsed > 60000u)
+		elapsed = 60000u;
+	const int64_t add = (int64_t)((elapsed * (uint64_t)pacer->rateBytesPerSec) / 1000u);
+	if (add > 0)
+	{
+		pacer->tokens += add;
+		if (pacer->tokens > (int64_t)pacer->burstBytes)
+			pacer->tokens = (int64_t)pacer->burstBytes;
+		pacer->lastTickMs = nowMs;
+	}
+}
+
+/* Returns 0 if a frame may be sent immediately, else ms until tokens > 0. */
+static inline uint32_t shadow_pacer_wait_ms(ShadowStreamPacer* pacer, uint64_t nowMs)
+{
+	if (!pacer || !pacer->initialized || pacer->rateBytesPerSec == 0)
+		return 0;
+	shadow_pacer_refill(pacer, nowMs);
+	if (pacer->tokens > 0)
+		return 0;
+	const uint64_t deficit = (uint64_t)(1 - pacer->tokens);
+	uint64_t wait = (deficit * 1000u + pacer->rateBytesPerSec - 1u) / pacer->rateBytesPerSec;
+	if (wait == 0)
+		wait = 1;
+	if (wait > 2000u)
+		wait = 2000u;
+	return (uint32_t)wait;
+}
+
+static inline void shadow_pacer_consume(ShadowStreamPacer* pacer, uint32_t bytes, uint64_t nowMs)
+{
+	if (!pacer || !pacer->initialized || pacer->rateBytesPerSec == 0)
+		return;
+	shadow_pacer_refill(pacer, nowMs);
+	pacer->tokens -= (int64_t)bytes;
+	const int64_t floorTokens = -(int64_t)pacer->burstBytes * 2;
+	if (pacer->tokens < floorTokens)
+		pacer->tokens = floorTokens;
+}
+
+/* Returns 0 when the next frame may be encoded immediately, else ms to wait.
+ * First frame after >= minInterval idle always returns 0. */
+static inline uint32_t shadow_fps_wait_ms(uint64_t lastFrameTickMs, uint32_t maxFps, uint64_t nowMs)
+{
+	if (maxFps == 0 || maxFps >= 60u || lastFrameTickMs == 0)
+		return 0;
+	const uint64_t minInterval = 1000u / maxFps;
+	if (nowMs <= lastFrameTickMs)
+		return (uint32_t)minInterval;
+	const uint64_t elapsed = nowMs - lastFrameTickMs;
+	return elapsed >= minInterval ? 0u : (uint32_t)(minInterval - elapsed);
+}
+
+#define SHADOW_RTT_RING_SIZE 32u
+#define SHADOW_RTT_MAX_SAMPLES 64u
+
+typedef struct
+{
+	uint32_t frameIds[SHADOW_RTT_RING_SIZE];
+	uint64_t sentTicks[SHADOW_RTT_RING_SIZE];
+	uint32_t samples[SHADOW_RTT_MAX_SAMPLES];
+	uint32_t sampleCount;
+} ShadowRttTracker;
+
+static inline void shadow_rtt_record_send(ShadowRttTracker* rtt, uint32_t frameId, uint64_t nowMs)
+{
+	if (!rtt || frameId == 0)
+		return;
+	const uint32_t slot = frameId & (SHADOW_RTT_RING_SIZE - 1u);
+	rtt->frameIds[slot] = frameId;
+	rtt->sentTicks[slot] = nowMs;
+}
+
+static inline void shadow_rtt_record_ack(ShadowRttTracker* rtt, uint32_t frameId, uint64_t nowMs)
+{
+	if (!rtt || frameId == 0)
+		return;
+	const uint32_t slot = frameId & (SHADOW_RTT_RING_SIZE - 1u);
+	if (rtt->frameIds[slot] != frameId)
+		return;
+	const uint64_t sent = rtt->sentTicks[slot];
+	rtt->frameIds[slot] = 0;
+	if (nowMs < sent)
+		return;
+	uint64_t delta = nowMs - sent;
+	if (delta > 60000u)
+		delta = 60000u;
+	if (rtt->sampleCount < SHADOW_RTT_MAX_SAMPLES)
+		rtt->samples[rtt->sampleCount++] = (uint32_t)delta;
+}
+
+/* Computes p50 and p95 (nearest-rank) and resets the window samples. */
+static inline int shadow_rtt_summarize(ShadowRttTracker* rtt, uint32_t* p50Ms, uint32_t* p95Ms)
+{
+	if (!rtt || rtt->sampleCount == 0)
+		return 0;
+	const uint32_t n = rtt->sampleCount;
+	for (uint32_t i = 1; i < n; i++)
+	{
+		const uint32_t key = rtt->samples[i];
+		uint32_t j = i;
+		while (j > 0 && rtt->samples[j - 1] > key)
+		{
+			rtt->samples[j] = rtt->samples[j - 1];
+			j--;
+		}
+		rtt->samples[j] = key;
+	}
+	const uint32_t idx50 = (n - 1u) / 2u;
+	uint32_t idx95 = (n * 95u + 99u) / 100u;
+	if (idx95 > 0)
+		idx95 -= 1u;
+	if (idx95 >= n)
+		idx95 = n - 1u;
+	if (p50Ms)
+		*p50Ms = rtt->samples[idx50];
+	if (p95Ms)
+		*p95Ms = rtt->samples[idx95];
+	rtt->sampleCount = 0;
+	return 1;
+}
+
+#endif
