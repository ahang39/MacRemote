diff --git a/libfreerdp/codec/h264_sps_vui.h b/libfreerdp/codec/h264_sps_vui.h
new file mode 100644
index 0000000..aef1c8a
--- /dev/null
+++ b/libfreerdp/codec/h264_sps_vui.h
@@ -0,0 +1,537 @@
+/* Pure-C H.264 SPS VUI low-latency rewriter.
+ *
+ * Apple VideoToolbox H.264 Baseline emits SPS NAL units without VUI
+ * parameters. Without bitstream_restriction.max_num_reorder_frames=0 and
+ * max_dec_frame_buffering=1, decoders such as Windows mstsc default to
+ * buffering up to Level MaxDpbFrames (4 at 1080p Level 4.0, 9 at 2304x1296
+ * Level 5.0), adding hundreds of milliseconds of latency on motion and
+ * stalling sparse desktop updates until synthetic drain frames are sent.
+ *
+ * This rewriter preserves all existing SPS fields (and any existing VUI fields
+ * such as colorimetry/full-range flags), sets vui_parameters_present_flag=1
+ * and bitstream_restriction_flag=1 with max_num_reorder_frames=0 and
+ * max_dec_frame_buffering=MAX(1, max_num_ref_frames), and re-inserts H.264
+ * emulation-prevention bytes. Any malformed or oversized SPS fails safely so
+ * the caller can emit the original NAL unit unchanged.
+ */
+#ifndef FREERDP_CODEC_H264_SPS_VUI_H
+#define FREERDP_CODEC_H264_SPS_VUI_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+typedef struct
+{
+	const uint8_t* data;
+	size_t bitLen;
+	size_t bitPos;
+} mrSpsBitReader;
+
+typedef struct
+{
+	uint8_t* data;
+	size_t byteCap;
+	size_t bitPos;
+} mrSpsBitWriter;
+
+typedef struct
+{
+	uint32_t profileIdc;
+	uint32_t levelIdc;
+	uint32_t maxNumRefFrames;
+	int vuiPresent;
+	int videoSignalPresent;
+	int videoFullRange;
+	int bitstreamRestrictionPresent;
+	uint32_t maxNumReorderFrames;
+	uint32_t maxDecFrameBuffering;
+} mrSpsVuiInfo;
+
+static inline int mr_sps_unescape(const uint8_t* nal, size_t nalLen, uint8_t* rbsp, size_t rbspCap,
+                                  size_t* rbspLen)
+{
+	if (!nal || !rbsp || !rbspLen || nalLen < 2)
+		return 0;
+	size_t out = 0;
+	unsigned zeros = 0;
+	for (size_t i = 1; i < nalLen; i++)
+	{
+		const uint8_t b = nal[i];
+		if (zeros == 2 && b == 3)
+		{
+			if (i + 1 >= nalLen || nal[i + 1] > 3)
+				return 0;
+			zeros = 0;
+			continue;
+		}
+		if (out >= rbspCap)
+			return 0;
+		rbsp[out++] = b;
+		zeros = (b == 0) ? (zeros < 2 ? zeros + 1 : 2) : 0;
+	}
+	*rbspLen = out;
+	return 1;
+}
+
+static inline int mr_sps_escape(uint8_t nalHeader, const uint8_t* rbsp, size_t rbspLen,
+                                uint8_t* outNal, size_t outCap, size_t* outLen)
+{
+	if (!rbsp || !outNal || !outLen || outCap < 1)
+		return 0;
+	size_t pos = 0;
+	outNal[pos++] = nalHeader;
+	unsigned zeros = 0;
+	for (size_t i = 0; i < rbspLen; i++)
+	{
+		const uint8_t b = rbsp[i];
+		if (zeros == 2 && b <= 3)
+		{
+			if (pos >= outCap)
+				return 0;
+			outNal[pos++] = 3;
+			zeros = 0;
+		}
+		if (pos >= outCap)
+			return 0;
+		outNal[pos++] = b;
+		zeros = (b == 0) ? (zeros < 2 ? zeros + 1 : 2) : 0;
+	}
+	*outLen = pos;
+	return 1;
+}
+
+static inline int mr_sps_read_bit(mrSpsBitReader* r, uint32_t* bit)
+{
+	if (r->bitPos >= r->bitLen)
+		return 0;
+	*bit = (uint32_t)((r->data[r->bitPos >> 3] >> (7u - (r->bitPos & 7u))) & 1u);
+	r->bitPos++;
+	return 1;
+}
+
+static inline int mr_sps_read_u(mrSpsBitReader* r, unsigned n, uint32_t* val)
+{
+	if (n == 0 || n > 32 || r->bitLen - r->bitPos < n)
+		return 0;
+	uint32_t v = 0;
+	for (unsigned i = 0; i < n; i++)
+	{
+		uint32_t b = 0;
+		if (!mr_sps_read_bit(r, &b))
+			return 0;
+		v = (v << 1) | b;
+	}
+	*val = v;
+	return 1;
+}
+
+static inline int mr_sps_read_ue(mrSpsBitReader* r, uint32_t* val)
+{
+	unsigned zeros = 0;
+	uint32_t b = 0;
+	while (1)
+	{
+		if (!mr_sps_read_bit(r, &b))
+			return 0;
+		if (b != 0)
+			break;
+		if (++zeros > 31)
+			return 0;
+	}
+	if (zeros == 31)
+	{
+		/* Only codeNum = UINT32_MAX fits; reject overflow safely. */
+		return 0;
+	}
+	uint32_t v = 1;
+	for (unsigned i = 0; i < zeros; i++)
+	{
+		if (!mr_sps_read_bit(r, &b))
+			return 0;
+		v = (v << 1) | b;
+	}
+	*val = v - 1u;
+	return 1;
+}
+
+static inline int32_t mr_sps_code_to_se(uint32_t code)
+{
+	return (code & 1u) ? (int32_t)((code + 1u) >> 1) : -(int32_t)(code >> 1);
+}
+
+static inline int mr_sps_write_bit(mrSpsBitWriter* w, uint32_t bit)
+{
+	if ((w->bitPos >> 3) >= w->byteCap)
+		return 0;
+	if ((w->bitPos & 7u) == 0)
+		w->data[w->bitPos >> 3] = 0;
+	if (bit & 1u)
+		w->data[w->bitPos >> 3] |= (uint8_t)(1u << (7u - (w->bitPos & 7u)));
+	w->bitPos++;
+	return 1;
+}
+
+static inline int mr_sps_write_u(mrSpsBitWriter* w, unsigned n, uint32_t val)
+{
+	if (n == 0 || n > 32)
+		return 0;
+	for (unsigned i = n; i > 0; i--)
+	{
+		if (!mr_sps_write_bit(w, (val >> (i - 1u)) & 1u))
+			return 0;
+	}
+	return 1;
+}
+
+static inline int mr_sps_write_ue(mrSpsBitWriter* w, uint32_t val)
+{
+	const uint64_t code = (uint64_t)val + 1u;
+	unsigned bits = 0;
+	for (uint64_t tmp = code; tmp > 0; tmp >>= 1)
+		bits++;
+	const unsigned zeros = bits - 1u;
+	for (unsigned i = 0; i < zeros; i++)
+	{
+		if (!mr_sps_write_bit(w, 0))
+			return 0;
+	}
+	for (unsigned i = bits; i > 0; i--)
+	{
+		if (!mr_sps_write_bit(w, (uint32_t)((code >> (i - 1u)) & 1u)))
+			return 0;
+	}
+	return 1;
+}
+
+static inline int mr_sps_copy_u(mrSpsBitReader* r, mrSpsBitWriter* w, unsigned n, uint32_t* val)
+{
+	uint32_t v = 0;
+	if (!mr_sps_read_u(r, n, &v))
+		return 0;
+	if (w && !mr_sps_write_u(w, n, v))
+		return 0;
+	if (val)
+		*val = v;
+	return 1;
+}
+
+static inline int mr_sps_copy_ue(mrSpsBitReader* r, mrSpsBitWriter* w, uint32_t* val)
+{
+	uint32_t v = 0;
+	if (!mr_sps_read_ue(r, &v))
+		return 0;
+	if (w && !mr_sps_write_ue(w, v))
+		return 0;
+	if (val)
+		*val = v;
+	return 1;
+}
+
+static inline int mr_sps_is_high_profile(uint32_t profile)
+{
+	switch (profile)
+	{
+		case 100:
+		case 110:
+		case 122:
+		case 244:
+		case 44:
+		case 83:
+		case 86:
+		case 118:
+		case 128:
+		case 138:
+		case 139:
+		case 134:
+		case 135:
+			return 1;
+		default:
+			return 0;
+	}
+}
+
+static inline int mr_sps_copy_hrd(mrSpsBitReader* r, mrSpsBitWriter* w)
+{
+	uint32_t cpbCnt = 0;
+	if (!mr_sps_copy_ue(r, w, &cpbCnt) || cpbCnt > 31)
+		return 0;
+	if (!mr_sps_copy_u(r, w, 4, NULL) || !mr_sps_copy_u(r, w, 4, NULL))
+		return 0;
+	for (uint32_t i = 0; i <= cpbCnt; i++)
+	{
+		if (!mr_sps_copy_ue(r, w, NULL) || !mr_sps_copy_ue(r, w, NULL) ||
+		    !mr_sps_copy_u(r, w, 1, NULL))
+			return 0;
+	}
+	if (!mr_sps_copy_u(r, w, 5, NULL) || !mr_sps_copy_u(r, w, 5, NULL) ||
+	    !mr_sps_copy_u(r, w, 5, NULL) || !mr_sps_copy_u(r, w, 5, NULL))
+		return 0;
+	return 1;
+}
+
+static inline int mr_sps_process(const uint8_t* inNal, size_t inLen, int rewrite, uint8_t* outNal,
+                                 size_t outCap, size_t* outLen, mrSpsVuiInfo* info)
+{
+	if (!inNal || inLen < 5 || inLen > 500 || (inNal[0] & 0x1Fu) != 7u)
+		return 0;
+	if (rewrite && (!outNal || !outLen))
+		return 0;
+
+	uint8_t inRbsp[512];
+	size_t inRbspLen = 0;
+	if (!mr_sps_unescape(inNal, inLen, inRbsp, sizeof(inRbsp), &inRbspLen) || inRbspLen < 4)
+		return 0;
+
+	uint8_t outRbsp[512];
+	mrSpsBitReader r = { .data = inRbsp, .bitLen = inRbspLen * 8u, .bitPos = 0 };
+	mrSpsBitWriter wStorage = { .data = outRbsp, .byteCap = sizeof(outRbsp), .bitPos = 0 };
+	mrSpsBitWriter* w = rewrite ? &wStorage : NULL;
+
+	mrSpsVuiInfo parsed;
+	memset(&parsed, 0, sizeof(parsed));
+
+	uint32_t profileIdc = 0;
+	uint32_t levelIdc = 0;
+	uint32_t tmp = 0;
+	if (!mr_sps_copy_u(&r, w, 8, &profileIdc) || !mr_sps_copy_u(&r, w, 8, &tmp) ||
+	    !mr_sps_copy_u(&r, w, 8, &levelIdc) || !mr_sps_copy_ue(&r, w, &tmp))
+		return 0;
+	parsed.profileIdc = profileIdc;
+	parsed.levelIdc = levelIdc;
+
+	if (mr_sps_is_high_profile(profileIdc))
+	{
+		uint32_t chroma = 0;
+		uint32_t scalingPresent = 0;
+		if (!mr_sps_copy_ue(&r, w, &chroma) || chroma > 3)
+			return 0;
+		if (chroma == 3 && !mr_sps_copy_u(&r, w, 1, &tmp))
+			return 0;
+		if (!mr_sps_copy_ue(&r, w, &tmp) || !mr_sps_copy_ue(&r, w, &tmp) ||
+		    !mr_sps_copy_u(&r, w, 1, &tmp) || !mr_sps_copy_u(&r, w, 1, &scalingPresent))
+			return 0;
+		if (scalingPresent)
+		{
+			const unsigned nLists = (chroma != 3) ? 8u : 12u;
+			for (unsigned i = 0; i < nLists; i++)
+			{
+				uint32_t listPresent = 0;
+				if (!mr_sps_copy_u(&r, w, 1, &listPresent))
+					return 0;
+				if (listPresent)
+				{
+					const unsigned sz = (i < 6u) ? 16u : 64u;
+					int lastScale = 8;
+					int nextScale = 8;
+					for (unsigned j = 0; j < sz; j++)
+					{
+						if (nextScale != 0)
+						{
+							uint32_t code = 0;
+							if (!mr_sps_copy_ue(&r, w, &code))
+								return 0;
+							const int delta = (int)mr_sps_code_to_se(code);
+							nextScale = ((lastScale + delta) % 256 + 256) % 256;
+						}
+						lastScale = (nextScale == 0) ? lastScale : nextScale;
+					}
+				}
+			}
+		}
+	}
+
+	uint32_t pocType = 0;
+	if (!mr_sps_copy_ue(&r, w, &tmp) || !mr_sps_copy_ue(&r, w, &pocType))
+		return 0;
+	if (pocType == 0)
+	{
+		if (!mr_sps_copy_ue(&r, w, &tmp))
+			return 0;
+	}
+	else if (pocType == 1)
+	{
+		uint32_t cycleLen = 0;
+		if (!mr_sps_copy_u(&r, w, 1, &tmp) || !mr_sps_copy_ue(&r, w, &tmp) ||
+		    !mr_sps_copy_ue(&r, w, &tmp) || !mr_sps_copy_ue(&r, w, &cycleLen) || cycleLen > 255)
+			return 0;
+		for (uint32_t i = 0; i < cycleLen; i++)
+		{
+			if (!mr_sps_copy_ue(&r, w, &tmp))
+				return 0;
+		}
+	}
+	else if (pocType > 2)
+		return 0;
+
+	uint32_t maxNumRefFrames = 0;
+	uint32_t frameMbsOnly = 0;
+	uint32_t cropping = 0;
+	if (!mr_sps_copy_ue(&r, w, &maxNumRefFrames) || !mr_sps_copy_u(&r, w, 1, &tmp) ||
+	    !mr_sps_copy_ue(&r, w, &tmp) || !mr_sps_copy_ue(&r, w, &tmp) ||
+	    !mr_sps_copy_u(&r, w, 1, &frameMbsOnly))
+		return 0;
+	parsed.maxNumRefFrames = maxNumRefFrames;
+
+	if (!frameMbsOnly && !mr_sps_copy_u(&r, w, 1, &tmp))
+		return 0;
+	if (!mr_sps_copy_u(&r, w, 1, &tmp) || !mr_sps_copy_u(&r, w, 1, &cropping))
+		return 0;
+	if (cropping)
+	{
+		if (!mr_sps_copy_ue(&r, w, &tmp) || !mr_sps_copy_ue(&r, w, &tmp) ||
+		    !mr_sps_copy_ue(&r, w, &tmp) || !mr_sps_copy_ue(&r, w, &tmp))
+			return 0;
+	}
+
+	uint32_t vuiPresent = 0;
+	if (!mr_sps_read_u(&r, 1, &vuiPresent))
+		return 0;
+	parsed.vuiPresent = (int)vuiPresent;
+
+	const uint32_t targetDpb = maxNumRefFrames > 1u ? maxNumRefFrames : 1u;
+	if (w && !mr_sps_write_u(w, 1, 1))
+		return 0;
+
+	if (!vuiPresent)
+	{
+		if (w)
+		{
+			/* aspect_ratio..pic_struct (8 flags = 0), bitstream_restriction_flag = 1 */
+			if (!mr_sps_write_u(w, 8, 0) || !mr_sps_write_u(w, 1, 1) ||
+			    !mr_sps_write_u(w, 1, 1) ||  /* motion_vectors_over_pic_boundaries_flag */
+			    !mr_sps_write_ue(w, 0) ||    /* max_bytes_per_pic_denom */
+			    !mr_sps_write_ue(w, 0) ||    /* max_bits_per_mb_denom */
+			    !mr_sps_write_ue(w, 16) ||   /* log2_max_mv_length_horizontal */
+			    !mr_sps_write_ue(w, 16) ||   /* log2_max_mv_length_vertical */
+			    !mr_sps_write_ue(w, 0) ||    /* max_num_reorder_frames = 0 */
+			    !mr_sps_write_ue(w, targetDpb))
+				return 0;
+		}
+	}
+	else
+	{
+		uint32_t flag = 0;
+		/* aspect_ratio_info_present_flag */
+		if (!mr_sps_copy_u(&r, w, 1, &flag))
+			return 0;
+		if (flag)
+		{
+			uint32_t idc = 0;
+			if (!mr_sps_copy_u(&r, w, 8, &idc))
+				return 0;
+			if (idc == 255u)
+			{
+				if (!mr_sps_copy_u(&r, w, 16, &tmp) || !mr_sps_copy_u(&r, w, 16, &tmp))
+					return 0;
+			}
+		}
+		/* overscan_info_present_flag */
+		if (!mr_sps_copy_u(&r, w, 1, &flag))
+			return 0;
+		if (flag && !mr_sps_copy_u(&r, w, 1, &tmp))
+			return 0;
+		/* video_signal_type_present_flag */
+		if (!mr_sps_copy_u(&r, w, 1, &flag))
+			return 0;
+		if (flag)
+		{
+			uint32_t fullRange = 0;
+			uint32_t colourDesc = 0;
+			parsed.videoSignalPresent = 1;
+			if (!mr_sps_copy_u(&r, w, 3, &tmp) || !mr_sps_copy_u(&r, w, 1, &fullRange) ||
+			    !mr_sps_copy_u(&r, w, 1, &colourDesc))
+				return 0;
+			parsed.videoFullRange = (int)fullRange;
+			if (colourDesc)
+			{
+				if (!mr_sps_copy_u(&r, w, 8, &tmp) || !mr_sps_copy_u(&r, w, 8, &tmp) ||
+				    !mr_sps_copy_u(&r, w, 8, &tmp))
+					return 0;
+			}
+		}
+		/* chroma_loc_info_present_flag */
+		if (!mr_sps_copy_u(&r, w, 1, &flag))
+			return 0;
+		if (flag && (!mr_sps_copy_ue(&r, w, &tmp) || !mr_sps_copy_ue(&r, w, &tmp)))
+			return 0;
+		/* timing_info_present_flag */
+		if (!mr_sps_copy_u(&r, w, 1, &flag))
+			return 0;
+		if (flag)
+		{
+			if (!mr_sps_copy_u(&r, w, 32, &tmp) || !mr_sps_copy_u(&r, w, 32, &tmp) ||
+			    !mr_sps_copy_u(&r, w, 1, &tmp))
+				return 0;
+		}
+		/* nal_hrd_parameters_present_flag & vcl_hrd_parameters_present_flag */
+		uint32_t nalHrd = 0;
+		uint32_t vclHrd = 0;
+		if (!mr_sps_copy_u(&r, w, 1, &nalHrd))
+			return 0;
+		if (nalHrd && !mr_sps_copy_hrd(&r, w))
+			return 0;
+		if (!mr_sps_copy_u(&r, w, 1, &vclHrd))
+			return 0;
+		if (vclHrd && !mr_sps_copy_hrd(&r, w))
+			return 0;
+		if ((nalHrd || vclHrd) && !mr_sps_copy_u(&r, w, 1, &tmp))
+			return 0;
+		/* pic_struct_present_flag */
+		if (!mr_sps_copy_u(&r, w, 1, &tmp))
+			return 0;
+		/* bitstream_restriction_flag */
+		uint32_t brPresent = 0;
+		if (!mr_sps_read_u(&r, 1, &brPresent))
+			return 0;
+		parsed.bitstreamRestrictionPresent = (int)brPresent;
+		if (w && !mr_sps_write_u(w, 1, 1))
+			return 0;
+		if (brPresent)
