diff --git a/server/shadow/Mac/mac_scaled_dirty.h b/server/shadow/Mac/mac_scaled_dirty.h
new file mode 100644
--- /dev/null
+++ b/server/shadow/Mac/mac_scaled_dirty.h
@@ -0,0 +1,75 @@
+/* Full-resolution BGRA/BGRX output damage comparison.
+ * For ScreenCaptureKit streams scaled to the RDP dimensions, the capture
+ * delegate conservatively refreshes the entire BGRA buffer because its dirty
+ * metadata can refer to source-space coordinates. We compare actual RGB pixels
+ * with the last published surface instead of trusting that imprecise region.
+ * Alpha/X is deliberately ignored: BGRX does not define channel 4.
+ *
+ * This is an exact lossless test, not a perceptual difference or checksum:
+ * changed pixels cannot be dropped. A high change count requests a full copy.
+ */
+#ifndef MAC_SCALED_DIRTY_H
+#define MAC_SCALED_DIRTY_H
+#include <stdint.h>
+#include <stddef.h>
+#define MAC_SCALED_DIRTY_TILE_SIZE 128u
+#define MAC_SCALED_DIRTY_FULL UINT32_MAX
+
+typedef struct
+{
+    uint16_t left, top, right, bottom;
+} macScaledDirtyRect;
+
+static inline int mac_scaled_tile_different(const uint8_t* src, size_t srcStride,
+                                            const uint8_t* old, size_t oldStride,
+                                            uint32_t left, uint32_t top,
+                                            uint32_t right, uint32_t bottom)
+{
+    for (uint32_t y = top; y < bottom; y++)
+    {
+        const uint8_t *s = src + (size_t)y * srcStride + (size_t)left * 4u;
+        const uint8_t *d = old + (size_t)y * oldStride + (size_t)left * 4u;
+        for (uint32_t x = left; x < right; x++, s += 4, d += 4)
+        {
+            if (s[0] != d[0] || s[1] != d[1] || s[2] != d[2])
+                return 1;
+        }
+    }
+    return 0;
+}
+
+/* Returns number of exact changed tiles, or MAC_SCALED_DIRTY_FULL when too
+ * much screen changed or any input is invalid. In the latter case, the
+ * caller must copy the full frame (never silently lose damage). */
+static inline uint32_t mac_scaled_collect_dirty(const uint8_t* src, size_t srcStride,
+                                                const uint8_t* previous, size_t previousStride,
+                                                uint32_t width, uint32_t height,
+                                                macScaledDirtyRect* rects, uint32_t capacity)
+{
+    if (!src || !previous || !rects || !capacity || !width || !height ||
+        width > UINT16_MAX || height > UINT16_MAX ||
+        srcStride < (size_t)width * 4u || previousStride < (size_t)width * 4u)
+        return MAC_SCALED_DIRTY_FULL;
+    uint32_t count = 0;
+    for (uint32_t y = 0; y < height; y += MAC_SCALED_DIRTY_TILE_SIZE)
+    {
+        const uint32_t bottom = (height - y < MAC_SCALED_DIRTY_TILE_SIZE)
+            ? height : y + MAC_SCALED_DIRTY_TILE_SIZE;
+        for (uint32_t x = 0; x < width; x += MAC_SCALED_DIRTY_TILE_SIZE)
+        {
+            const uint32_t right = (width - x < MAC_SCALED_DIRTY_TILE_SIZE)
+                ? width : x + MAC_SCALED_DIRTY_TILE_SIZE;
+            if (mac_scaled_tile_different(src, srcStride, previous, previousStride,
+                                          x, y, right, bottom))
+            {
+                if (count == capacity)
+                    return MAC_SCALED_DIRTY_FULL;
+                rects[count++] = (macScaledDirtyRect){
+                    (uint16_t)x, (uint16_t)y, (uint16_t)right, (uint16_t)bottom
+                };
+            }
+        }
+    }
+    return count;
+}
+#endif
