+static UINT32 (*avc420_bitrate_provider)(const rdpShadowClient*);
+
+FREERDP_API void shadow_client_set_avc420_bitrate_provider(
+    UINT32 (*provider)(const rdpShadowClient*));
+void shadow_client_set_avc420_bitrate_provider(UINT32 (*provider)(const rdpShadowClient*))
+{
+	avc420_bitrate_provider = provider;
 }
 
+WINPR_ATTR_NODISCARD
+static BOOL shadow_client_update_avc420_bitrate(rdpShadowClient* client)
+{
+	if (!avc420_bitrate_provider)
+		return TRUE;
+
+	UINT32 target = avc420_bitrate_provider(client);
+	if (target == 0)
+		target = client->server->h264BitRate;
+
+	H264_CONTEXT* h264 = client->encoder->h264;
+	if (h264_context_get_option(h264, H264_CONTEXT_OPTION_BITRATE) == target)
+		return TRUE;
+	if (!h264_context_set_option(h264, H264_CONTEXT_OPTION_BITRATE, target))
+		return FALSE;
+
+	WLog_INFO(TAG, "MacRemote AVC420 target bitrate=%" PRIu32, target);
+	return TRUE;
+}
