+/* AVC420 updates and presentation-drain pictures share one RDPGFX send
+ * path. The metadata remains owned by the caller until the send completes. */
+static UINT shadow_client_emit_avc420(rdpShadowClient* client,
+                                      RDPGFX_SURFACE_COMMAND* command,
+                                      const RDPGFX_START_FRAME_PDU* start,
+                                      const RDPGFX_END_FRAME_PDU* end,
+                                      RDPGFX_AVC420_BITMAP_STREAM* frame)
+{
+	command->codecId = RDPGFX_CODECID_AVC420;
+	command->extra = frame;
+	UINT error = CHANNEL_RC_OK;
+	IFCALLRET(client->rdpgfx->SurfaceFrameCommand, error, client->rdpgfx,
+	          command, start, end);
+	command->extra = nullptr;
+	return error;
+}
