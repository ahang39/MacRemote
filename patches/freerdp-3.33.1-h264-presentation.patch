+/* Release buffered pictures on an otherwise idle MSTSC decoder.
+ * Each P picture uses the last captured desktop; no new screen damage. */
+WINPR_ATTR_NODISCARD
+static BOOL shadow_client_flush_avc420(rdpShadowClient* client, UINT32 count)
+{
+	rdpShadowEncoder* encoder = client->encoder;
+	const UINT32 width = freerdp_settings_get_uint32(client->context.settings, FreeRDP_DesktopWidth);
+	const UINT32 height = freerdp_settings_get_uint32(client->context.settings, FreeRDP_DesktopHeight);
+	RDPGFX_SURFACE_COMMAND command = WINPR_C_ARRAY_INIT;
+	command.surfaceId = client->surfaceId;
+	command.format = PIXEL_FORMAT_BGRX32;
+	command.right = command.width = width;
+	command.bottom = command.height = height;
+	UINT64 bytes = 0;
+
+	for (UINT32 n = 0; n < count; n++)
+	{
+		RDPGFX_AVC420_BITMAP_STREAM frame = WINPR_C_ARRAY_INIT;
+		if (avc420_repeat(encoder->h264, width, height,
+		                  &frame.data, &frame.length, &frame.meta) < 0)
+			return FALSE;
+
+		RDPGFX_START_FRAME_PDU start = WINPR_C_ARRAY_INIT;
+		RDPGFX_END_FRAME_PDU end = WINPR_C_ARRAY_INIT;
+		start.frameId = end.frameId = shadow_encoder_create_frame_id(encoder);
+		SYSTEMTIME tm = WINPR_C_ARRAY_INIT;
+		GetSystemTime(&tm);
+		start.timestamp = (UINT32)(tm.wHour << 22u | tm.wMinute << 16u |
+		                           tm.wSecond << 10u | tm.wMilliseconds);
+		bytes += frame.length;
+		const UINT error = shadow_client_emit_avc420(client, &command, &start, &end, &frame);
+		free_h264_metablock(&frame.meta);
+		if (error != CHANNEL_RC_OK)
+			return FALSE;
+	}
+	WLog_DBG(TAG, "MacRemote AVC420 drain frames=%" PRIu32 " payload=%" PRIu64,
+	         count, bytes);
+	return TRUE;
+}
