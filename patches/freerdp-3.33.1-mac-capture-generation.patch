diff --git a/server/shadow/Mac/mac_capture_generation.h b/server/shadow/Mac/mac_capture_generation.h
new file mode 100644
--- /dev/null
+++ b/server/shadow/Mac/mac_capture_generation.h
@@ -0,0 +1,20 @@
+#ifndef MAC_CAPTURE_GENERATION_H
+#define MAC_CAPTURE_GENERATION_H
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdatomic.h>
+/* Generation token: retired SCK stream callbacks never affect the new stream. */
+typedef struct {
+    atomic_uint_fast64_t current;
+} macCaptureGeneration;
+static inline uint64_t mr_capture_generation_next(macCaptureGeneration* state)
+{
+    return atomic_fetch_add_explicit(&state->current, 1, memory_order_acq_rel) + 1;
+}
+static inline bool mr_capture_generation_current(const macCaptureGeneration* state,
+                                                 uint64_t token)
+{
+    return state && token != 0 &&
+        atomic_load_explicit(&state->current, memory_order_acquire) == token;
+}
+#endif
