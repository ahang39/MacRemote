diff --git a/server/shadow/Mac/macremote_capture_logical.h b/server/shadow/Mac/macremote_capture_logical.h
new file mode 100644
index 0000000..07fa3b3
--- /dev/null
+++ b/server/shadow/Mac/macremote_capture_logical.h
@@ -0,0 +0,39 @@
+#ifndef MACREMOTE_CAPTURE_LOGICAL_H
+#define MACREMOTE_CAPTURE_LOGICAL_H
+
+#include <CoreGraphics/CoreGraphics.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+/* GUI + native connect publish the actual macOS logical mode, atomically.
+ * Quartz may hold stale per-process display bounds inside a headless Shadow
+ * process; this small one-way file is authoritative for video and input.
+ * If absent or invalid, preserve upstream Quartz bounds. */
+static inline bool mr_capture_override_bounds(CGDirectDisplayID display, CGRect* bounds)
+{
+    if (!bounds)
+        return false;
+    const char* home = getenv("HOME");
+    if (!home || !*home)
+        return false;
+    char path[PATH_MAX];
+    const int n = snprintf(path, sizeof(path),
+        "%s/Library/Application Support/MacRemote/capture-logical.conf", home);
+    if (n < 0 || (size_t)n >= sizeof(path))
+        return false;
+    FILE* file = fopen(path, "r");
+    if (!file)
+        return false;
+    unsigned id = 0, width = 0, height = 0;
+    const int count = fscanf(file, "%u %u %u", &id, &width, &height);
+    fclose(file);
+    if (count != 3 || id != display || width < 640 || width > 8192 ||
+        height < 400 || height > 4320)
+        return false;
+    bounds->size.width = width;
+    bounds->size.height = height;
+    return true;
+}
+#endif
diff --git a/server/shadow/Mac/macremote_surface_geometry.h b/server/shadow/Mac/macremote_surface_geometry.h
new file mode 100644
index 0000000..948c9b5
--- /dev/null
+++ b/server/shadow/Mac/macremote_surface_geometry.h
@@ -0,0 +0,66 @@
+#ifndef MACREMOTE_SURFACE_GEOMETRY_H
+#define MACREMOTE_SURFACE_GEOMETRY_H
+
+/* A ScreenCaptureKit display stream can preserve aspect ratio, making the
+ * captured image smaller than the RDP surface on one axis. The exact same
+ * destination rectangle must be used for video, input and cursor feedback. */
+#include <math.h>
+#include <stdbool.h>
+
+typedef struct
+{
+    double left;
+    double top;
+    double width;
+    double height;
+} mrSurfaceViewport;
+
+static inline mrSurfaceViewport mr_surface_fit(double sourceW, double sourceH,
+                                               double streamW, double streamH)
+{
+    mrSurfaceViewport result = { 0, 0, 0, 0 };
+    if (!(sourceW > 0) || !(sourceH > 0) || !(streamW > 0) || !(streamH > 0))
+        return result;
+    const double scale = fmin(streamW / sourceW, streamH / sourceH);
+    result.width = floor(sourceW * scale + 0.5);
+    result.height = floor(sourceH * scale + 0.5);
+    result.left = floor((streamW - result.width) * 0.5);
+    result.top = floor((streamH - result.height) * 0.5);
+    return result;
+}
+
+/* With a scaled/letterboxed capture, refresh the full local pixel buffer:
+ * partial capture dirty rectangles may not map to destination coordinates.
+ * H.264 still encodes only actual pixel differences over time. */
+static inline bool mr_surface_scaled_capture(double sourceW, double sourceH,
+                                             double streamW, double streamH,
+                                             mrSurfaceViewport viewport)
+{
+    return fabs(sourceW - streamW) > 0.5 || fabs(sourceH - streamH) > 0.5 ||
+           viewport.left != 0 || viewport.top != 0 ||
+           fabs(viewport.width - streamW) > 0.5 ||
+           fabs(viewport.height - streamH) > 0.5;
+}
+
+/* Input coordinates, in RDP pixels, to the source display's logical points. */
+static inline double mr_surface_to_logical(double coord, double offset,
+                                           double length, double logicalLength)
+{
+    if (!(length > 0) || !(logicalLength > 0))
+        return 0;
+    const double value = (coord - offset) * logicalLength / length;
+    return fmin(fmax(value, 0), logicalLength - 1);
+}
+
+/* Display logical points to RDP video/cursor pixels, including letterbox. */
+static inline double mr_logical_to_surface(double coord, double offset,
+                                           double length, double logicalLength,
+                                           double surfaceLength)
+{
+    if (!(length > 0) || !(logicalLength > 0) || !(surfaceLength > 0))
+        return 0;
+    const double value = offset + coord * length / logicalLength;
+    return fmin(fmax(value, 0), surfaceLength - 1);
+}
+
+#endif /* MACREMOTE_SURFACE_GEOMETRY_H */
