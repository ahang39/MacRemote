diff --git a/include/freerdp/server/shadow_color_depth_compat.h b/include/freerdp/server/shadow_color_depth_compat.h
new file mode 100644
--- /dev/null
+++ b/include/freerdp/server/shadow_color_depth_compat.h
@@ -0,0 +1,15 @@
+/* FreeRDP shadow transport is selected from the negotiated client
+ * desktop bit depth. NSCodec and AVC420 carry 32-bit pixels only. */
+#ifndef MACREMOTE_SHADOW_COLOR_DEPTH_COMPAT_H
+#define MACREMOTE_SHADOW_COLOR_DEPTH_COMPAT_H
+#include <stdbool.h>
+#include <stdint.h>
+static inline bool mr_shadow_use_legacy_bitmap(uint32_t depth)
+{
+    return depth < 32;
+}
+static inline bool mr_shadow_use_surface_bits(uint32_t depth, bool supported)
+{
+    return !mr_shadow_use_legacy_bitmap(depth) && supported;
+}
+#endif
